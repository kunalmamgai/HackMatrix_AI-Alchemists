generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  picture       String?
  googleId      String    @unique
  role          String    @default("user") // user | center_admin | admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  pickups       PickupRequest[]
  reviews       Review[]
}

model Product {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  category      String
  description   String
  price         Int       // in paise (INR)
  condition     String    // Excellent | Good | Fair
  image         String
  stock         Int       @default(0)
  featured      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderItems    OrderItem[]
  reviews       Review[]
}

model Order {
  id            String    @id @default(cuid())
  userId        String
  status        String    @default("pending") // pending | paid | shipped | delivered | cancelled
  totalAmount   Int       // in paise
  taxAmount     Int       @default(0)
  shippingFee   Int       @default(5000) // 50 INR in paise
  paymentMethod String    @default("card") // card | upi | wallet
  stripePaymentId String?
  shippingAddress String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int       @default(1)
  priceAtPurchase Int     // snapshot of price at time of order

  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])
}

model RecyclingCenter {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  address       String
  city          String
  state         String
  pincode       String
  latitude      Float
  longitude     Float
  phone         String?
  email         String?
  website       String?
  verified      Boolean   @default(false)
  rating        Float     @default(0)
  reviewCount   Int       @default(0)
  acceptedTypes String    // comma-separated: Electronics, Hazardous, etc
  operatingHours String   // e.g. "Mon-Sat: 9AM-6PM"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pickups       PickupRequest[]
  reviews       Review[]
}

model PickupRequest {
  id            String    @id @default(cuid())
  userId        String
  centerId      String?
  status        String    @default("pending") // pending | scheduled | picked_up | completed | cancelled
  address       String
  city          String
  scheduledDate DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User            @relation(fields: [userId], references: [id])
  center        RecyclingCenter? @relation(fields: [centerId], references: [id])
  items         PickupItem[]
}

model PickupItem {
  id            String    @id @default(cuid())
  pickupId      String
  deviceType    String
  quantity      Int       @default(1)
  condition     String?

  pickup        PickupRequest @relation(fields: [pickupId], references: [id], onDelete: Cascade)
}

model Review {
  id            String    @id @default(cuid())
  userId        String
  productId     String?
  centerId      String?
  rating        Int       // 1-5
  comment       String?
  createdAt     DateTime  @default(now())

  user          User             @relation(fields: [userId], references: [id])
  product       Product?         @relation(fields: [productId], references: [id])
  center        RecyclingCenter? @relation(fields: [centerId], references: [id])
}
